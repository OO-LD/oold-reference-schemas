{
  "$schema": "https://oo-ld.org/latest/meta/oold-meta-schema.json",
  "$id": "Distribution.schema.json",
  "x-oold-uuid": "48afb1c5-af8b-5e6d-a6c9-11de0aec2ca5",
  "x-oold-version": "0.1.0",
  "title": "Distribution",
  "x-oold-instance-rdf-type": [
    "Distribution"
  ],
  "description": "A serialisation of a dataset: where the bytes are, in which format, and which schema they embody. Storage, not content: `conforms_to` points back at the dataset schema the bytes are an encoding of.",
  "examples": [
    {
      "type": [
        "Distribution"
      ],
      "download_url": "https://example.org/data/LFP-042-cycling.csv",
      "media_type": "text/csv"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "Distribution"
      ]
    },
    "download_url": {
      "type": "string",
      "format": "iri-reference"
    },
    "access_url": {
      "type": "string",
      "format": "iri-reference",
      "description": "Landing page where the file is reached indirectly"
    },
    "media_type": {
      "type": "string",
      "description": "IANA media type of the bytes, written as the media type itself. dcat:mediaType ranges over dcterms:MediaType and DCAT-AP requires the IANA vocabulary, so the term resolves the value against that namespace.",
      "examples": [
        "text/csv"
      ]
    },
    "byte_size": {
      "type": "integer",
      "description": "Size in bytes. DCAT-AP types this xsd:nonNegativeInteger; the term is left uncoerced because a pinned datatype does not survive the RDF round trip: fromRDF with native types drops it, and the term no longer matches on the way back."
    },
    "package_format": {
      "type": "string",
      "examples": [
        "application/zip"
      ]
    },
    "file": {
      "type": "string",
      "format": "iri-reference",
      "x-oold-range": "File.schema.json",
      "description": "IRI of the bytes this distribution serves. Two datasets over one file are two distributions naming one file, so the checksum is stated once and the properties that hold only for one reading stay on the distribution."
    },
    "conforms_to": {
      "type": "string",
      "format": "iri-reference",
      "description": "IRI of the dataset schema these bytes embody"
    },
    "table_schema": {
      "type": "string",
      "format": "iri-reference",
      "description": "IRI of the row schema, where the serialisation is tabular"
    },
    "selector": {
      "allOf": [
        {
          "$ref": "#/$defs/FragmentSelector"
        }
      ],
      "description": "The part of the container this dataset is, where no fragment syntax covers the case. Where one does, RFC 7111 for CSV or Media Fragments for media, put it in download_url instead and leave this out."
    },
    "access_service": {
      "type": "string",
      "format": "iri-reference",
      "x-oold-range": "DataService.schema.json",
      "description": "IRI of the service through which these bytes are reached."
    }
  },
  "required": [
    "type"
  ],
  "@context": {
    "@version": 1.1,
    "dcat": "http://www.w3.org/ns/dcat#",
    "dcterms": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "csvw": "http://www.w3.org/ns/csvw#",
    "schema": "http://schema.org/",
    "qudt": "http://qudt.org/schema/qudt/",
    "qunit": "http://qudt.org/vocab/unit/",
    "qkind": "http://qudt.org/vocab/quantitykind/",
    "emmo": "https://w3id.org/emmo#",
    "echem": "https://w3id.org/emmo/domain/electrochemistry#",
    "obo": "http://purl.obolibrary.org/obo/",
    "oa": "http://www.w3.org/ns/oa#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "iana": "http://www.iana.org/assignments/media-types/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "distribution": {
      "@id": "https://w3id.org/oo-ld/schemas/datasets/0.1/Distribution.schema.json#",
      "@prefix": true
    },
    "id": "@id",
    "type": {
      "@id": "@type",
      "@container": "@set"
    },
    "Distribution": "dcat:Distribution",
    "download_url": {
      "@id": "dcat:downloadURL",
      "@type": "@id"
    },
    "access_url": {
      "@id": "dcat:accessURL",
      "@type": "@id"
    },
    "media_type": {
      "@id": "dcat:mediaType",
      "@type": "@vocab",
      "@context": {
        "@vocab": "http://www.iana.org/assignments/media-types/"
      }
    },
    "byte_size": "dcat:byteSize",
    "package_format": {
      "@id": "dcat:packageFormat",
      "@type": "@id"
    },
    "file": {
      "@id": "schema:associatedMedia",
      "@type": "@id"
    },
    "conforms_to": {
      "@id": "dcterms:conformsTo",
      "@type": "@id"
    },
    "table_schema": {
      "@id": "csvw:tableSchema",
      "@type": "@id"
    },
    "selector": "oa:hasSelector",
    "FragmentSelector": "oa:FragmentSelector",
    "fragment": "rdf:value",
    "access_service": {
      "@id": "dcat:accessService",
      "@type": "@id"
    }
  },
  "x-oold-context": {
    "Distribution": {
      "schema:DataDownload": {
        "x-oold-sssom": {
          "predicate_id": "skos:closeMatch",
          "mapping_set_id": "https://w3id.org/oo-ld/schemas/mappings/schemaorg.sssom.tsv"
        }
      }
    },
    "download_url": {
      "schema:contentUrl": {
        "x-oold-sssom": {
          "predicate_id": "skos:closeMatch",
          "mapping_set_id": "https://w3id.org/oo-ld/schemas/mappings/schemaorg.sssom.tsv"
        }
      }
    },
    "media_type": {
      "schema:encodingFormat": {
        "x-oold-sssom": {
          "predicate_id": "skos:closeMatch",
          "mapping_set_id": "https://w3id.org/oo-ld/schemas/mappings/schemaorg.sssom.tsv"
        }
      }
    }
  },
  "$comment": "dcterms:format is reserved: the Dataspace Protocol claims it for the transfer channel (values such as HttpData-PULL), so the file format goes on dcat:mediaType and the schema the bytes embody on dcterms:conformsTo.",
  "$defs": {
    "FragmentSelector": {
      "type": "object",
      "title": "FragmentSelector",
      "description": "A part of a resource, and the syntax the expression is written in.",
      "properties": {
        "type": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "FragmentSelector"
          ]
        },
        "fragment": {
          "type": "string",
          "description": "The expression that picks the part.",
          "examples": [
            "/cell42/cycling"
          ]
        },
        "conforms_to": {
          "type": "string",
          "format": "iri-reference",
          "description": "IRI of the specification the expression follows."
        }
      },
      "required": [
        "type",
        "fragment",
        "conforms_to"
      ]
    }
  }
}
