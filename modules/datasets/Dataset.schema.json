  "$id": "Dataset.schema.json",
  "x-oold-version": "0.1.0",
  "title": "Dataset",
  "x-oold-instance-rdf-type": [
    "dcat:Dataset"
  ],
  "description": "Data published as one thing. Metadata lives in the fields; `data` is the interpreted payload, and the type of `data` is the schema, so there is no separate schema object. A distribution is a serialisation of the same dataset.",
  "examples": [
    {
      "type": [
        "Dataset"
      ],
      "title": "Cycling of cell LFP-042",
      "license": "https://creativecommons.org/licenses/by/4.0/"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "Dataset"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "issued": {
      "type": "string",
      "format": "date"
    },
    "license": {
      "type": "string",
      "format": "iri-reference"
    },
    "about": {
      "type": "string",
      "format": "iri-reference",
      "description": "IRI of what the data is about, the sample or device it was taken from"
    },
    "generated_by": {
      "type": "string",
      "format": "iri-reference",
      "description": "IRI of the process that produced it"
    },
    "data": {
      "description": "The interpreted payload. Its type is the schema, so a subschema restricts it; absent where the payload lives in a distribution"
    },
    "distributions": {
      "type": "array",
      "items": {
        "$ref": "Distribution.schema.json"
      },
      "description": "Serialisations of this dataset"
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "iri-reference"
      },
      "x-oold-range": "Dataset.schema.json",
      "description": "IRIs of sub-datasets"
    }
  },
  "required": [
    "type"
  ],
  "@context": [
    "Distribution.schema.json",
    {
      "@version": 1.1,
      "dcat": "http://www.w3.org/ns/dcat#",
