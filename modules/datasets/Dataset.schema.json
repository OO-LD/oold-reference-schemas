        "@container": "@set"
      },
      "Dataset": "dcat:Dataset",
      "title": "dcterms:title",
      "description": "dcterms:description",
      "issued": {
        "@id": "dcterms:issued",
        "@type": "xsd:date"
      },
      "license": {
        "@id": "dcterms:license",
        "@type": "@id"
      },
      "about": {
        "@id": "schema:about",
        "@type": "@id"
      },
      "generated_by": {
        "@id": "prov:wasGeneratedBy",
        "@type": "@id"
      },
      "data": {
        "@id": "dataset:/properties/data",
        "@type": "@id",
        "@container": "@set"
      },
      "distributions": {
        "@id": "dcat:distribution",
        "@type": "@id",
        "@container": "@set"
      },
      "parts": {
        "@id": "dcterms:hasPart",
        "@type": "@id",
        "@container": "@set"
      }
    }
  ],
