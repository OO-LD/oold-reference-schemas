{
  "$schema": "https://oo-ld.org/latest/meta/oold-meta-schema.json",
  "$id": "CyclingTable.schema.json",
  "x-oold-version": "0.1.0",
  "title": "CyclingTable",
  "x-oold-instance-rdf-type": [
    "csvw:Schema"
  ],
  "description": "What the columns of a battery cycling file mean, and which cell and protocol produced it. It describes the rows; the file itself is a Distribution and the publication around it is a Dataset.",
  "examples": [
    {
      "type": [
        "CyclingTable"
      ],
      "cell": "https://example.org/cell/LFP-042",
      "protocol": "CC-CV charge at 1C to 3.65 V, rest 10 min, CC discharge at 1C to 2.5 V",
      "columns": [
        {
          "type": [
            "Column"
          ],
          "name": "time",
          "quantity": "Time",
          "unit": "second"
        },
        {
          "type": [
            "Column"
          ],
          "name": "voltage",
          "quantity": "Voltage",
          "unit": "volt"
        },
        {
          "type": [
            "Column"
          ],
          "name": "current",
          "quantity": "ElectricCurrent",
          "unit": "milli_ampere"
        }
      ]
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "CyclingTable"
      ]
    },
    "cell": {
      "type": "string",
      "format": "iri-reference",
      "description": "IRI of the cell the run measured"
    },
    "protocol": {
      "type": "string",
      "description": "The cycling procedure, as text until a protocol schema exists"
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "description": "One entry per column of the recorded table",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Column"
            ]
          },
          "name": {
            "type": "string",
            "description": "Column header as it appears in the file"
          },
          "quantity": {
            "type": "string",
            "enum": [
              "Time",
              "Voltage",
              "ElectricCurrent"
            ],
            "description": "What the column measures"
          },
          "unit": {
            "type": "string",
            "enum": [
              "second",
              "hour",
              "volt",
              "milli_volt",
              "ampere",
              "milli_ampere"
            ],
            "description": "Unit the column is recorded in"
          }
        },
        "required": [
          "type",
          "name",
          "quantity",
          "unit"
        ]
      }
    }
  },
  "required": [
    "type",
    "cell",
    "columns"
  ],
