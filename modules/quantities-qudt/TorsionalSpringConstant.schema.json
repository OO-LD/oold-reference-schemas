  "x-oold-multilang-title": {
    "en": "Torsional spring constant",
    "de": "Federkonstante Drehfeder"
  },
  "description": "A torsional spring constant is a measure of the stiffness of a torsional spring, which is a type of spring that experiences twisting or torque rather than compression or extension. It is typically measured in newton-meters per radian (N·m/rad) and is used to calculate the amount of torque required to twist a spring a certain amount. It is related to the spring's geometry, material properties, and manufacturing process.",
  "examples": [
    {
      "type": [
        "TorsionalSpringConstant"
      ],
      "value": 1.0,
      "unit": "meter_newton_per_radian"
    }
  ],
  "allOf": [
    {
      "$ref": "https://w3id.org/oo-ld/schemas/quantities/0.2/QuantityValue.schema.json"
    }
  ],
  "@context": [
    "https://w3id.org/oo-ld/schemas/quantities/0.2/QuantityValue.schema.json",
    {
      "qkind": "http://qudt.org/vocab/quantitykind/",
      "TorsionalSpringConstant": "qkind:TorsionalSpringConstant",
      "meter_newton_per_radian": "qunit:N-M-PER-RAD",
      "meter_newton_per_degree": "qunit:N-M-PER-DEG",
      "kilo_newton_meter_per_degree": "qunit:KiloN-M-PER-DEG"
    }
  ],
  "properties": {
    "type": {
