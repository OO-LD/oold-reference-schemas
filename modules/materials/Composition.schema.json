    "ChemicalComposition": "self:/$defs/ChemicalComposition",
    "Component": "self:/$defs/Component",
    "Fe": "emmo:EMMO_71b5082d-9908-5011-8ad0-b2ab70ffd08c",
    "Si": "emmo:EMMO_4f9670f5-14ca-53da-a1ea-9b0550a61035",
    "C": "emmo:EMMO_a7180b5f-d46d-5751-b3bc-ae28a6655992",
    "composition": {
      "@id": "self:/properties/composition",
      "@type": "@id"
    },
    "components": {
      "@id": "self:/$defs/ChemicalComposition/properties/components",
      "@type": "@id",
      "@container": "@set"
    },
    "constituent": {
      "@id": "self:/$defs/Component/properties/constituent",
      "@type": "@vocab"
    },
    "amount": {
      "@id": "self:/$defs/Component/properties/amount",
      "@type": "@id"
    },
    "qudt": "http://qudt.org/schema/qudt/",
    "qunit": "http://qudt.org/vocab/unit/",
    "value": "qudt:value",
    "unit": {
      "@id": "qudt:hasUnit",
      "@type": "@vocab"
    },
    "standard_uncertainty": "qudt:standardUncertainty",
    "qkind": "http://qudt.org/vocab/quantitykind/",
    "MassFraction": "qkind:MassFraction",
    "PERCENT": "qunit:PERCENT",
    "PPM": "qunit:PPM"
  },
