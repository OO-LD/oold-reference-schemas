{
  "$schema": "https://oo-ld.org/latest/meta/oold-meta-schema.json",
  "@id": "Context.schema.json",
  "title": "Composition",
  "description": "Chemical composition of a substance.",
  "type": "object",
  "@context": {
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "mat": "https://w3id.org/materialsDCAT-AP/profile#",
    "component": {
      "@id": "mat:hasComponent",
      "@type": "@id"
    },
    "constituent": {
      "@id": "mat:hasConstituent",
      "@type": "@id"
    },
    "amount": {
      "@id": "mat:hasAmount",
      "@type": "@id"
    },
    "value": {
      "@id": "mat:dataValue",
      "@type": "xsd:double"
    },
    "unit": {
      "@id": "mat:hasMeasurementUnit",
      "@type": "@id"
    },

    "MassFraction": {
      "@id": "mat:MassFraction",
      "@type": "@id"
    },
    "AtomFraction": {
      "@id": "mat:AtomFraction",
      "@type": "@id"
    },
    "PERCENT": {
      "@id": "???",
      "@type": "@id"
    },
    "PPM": {
      "@id": "???",
      "@type": "@id"
    }

  },
  "properties": {
    "component": {
      "type": "object",
      "description": "A component of a composition.",
      "properties": {
        "constituent": {
          "type": "string",
          "description": "Chemical constituent or species.",
          "examples": ["Fe", "CH4"]
        },
        "amount": {
          "type": "object",
          "description": "Physical quantity that the express the amount of the constituent.",
          "properties": {
            "type": {
              "type": "string",
              "description": "Name of physical quantity expressing the amount of the constituent.",
              "examples": ["MassFraction", "AtomFraction"]
            },
            "value": {
              "type": "number",
              "description": "Value of the amount.",
              "examples": [0.32]
            },
            "unit": {
              "type": "string",
              "description": "Measurement unit."
              "examples": ["PERCENT", "PPM"]
            }
          }
        }
      }
    }
  }
}
