{
  "$schema": "https://oo-ld.org/latest/meta/oold-meta-schema.json",
  "$id": "Composition.schema.json",
  "x-oold-version": "0.1.0",
  "title": "Composition",
  "description": "What every composition shares: components, each with an amount. The constituent is what differs, so it is declared by the subschemas. Terms in this schema's own IRI space are placeholders for a vocabulary that is not agreed yet, not a third ontology: they carry no axioms, and each records what it means in EMMO and in PMDco.",
  "type": "object",
  "properties": {
    "type": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "Composition"
      ]
    }
  },
  "$defs": {
    "Component": {
      "type": "object",
      "title": "Component",
      "description": "One constituent of a composition and how much of it there is.",
      "properties": {
        "type": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Component"
          ]
        },
        "amount": {
          "type": "object",
          "title": "MassFraction",
          "description": "Mirrors quantities/MassFraction until a cross-module $ref resolves; the quantity, not the unit, says the percentage is by mass",
          "properties": {
            "type": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "MassFraction"
              ]
            },
            "value": {
              "type": "number"
            },
            "unit": {
              "enum": [
                "percent",
                "part_per_million"
              ],
              "default": "percent"
            },
            "standard_uncertainty": {
              "type": "number",
              "description": "Standard uncertainty, expressed in the unit of value (GUM convention)"
            }
          },
          "required": [
            "type",
            "value",
            "unit"
          ]
        }
      },
      "required": [
        "type",
        "amount"
      ]
    }
  },
