{
  "$schema": "https://oo-ld.org/latest/meta/oold-meta-schema.json",
  "$id": "Composition.schema.json",
  "x-oold-version": "0.1.0",
  "title": "Composition",
  "description": "A material and its chemical composition: one entry per constituent, with the amount as a typed quantity. Terms in this schema's own IRI space are placeholders for a vocabulary that is not agreed yet, not a third ontology: they carry no axioms, and each records what it means in EMMO and in PMDco.",
  "examples": [
    {
      "type": [
        "Material"
      ],
      "composition": {
        "type": [
          "ChemicalComposition"
        ],
        "components": [
          {
            "type": [
              "Component"
            ],
            "constituent": "Fe",
            "amount": {
              "type": [
                "MassFraction"
              ],
              "value": 96.7,
              "unit": "PERCENT"
            }
          }
        ]
      }
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "Material"
      ]
    },
    "composition": {
      "$ref": "#/$defs/ChemicalComposition"
    }
  },
  "required": [
    "composition"
  ],
  "$defs": {
    "ChemicalComposition": {
      "type": "object",
      "title": "ChemicalComposition",
      "description": "The constituents of a material and how much of each.",
      "properties": {
        "type": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "ChemicalComposition"
          ]
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Component"
          }
        }
      },
      "required": [
        "components"
      ]
    },
    "Component": {
      "type": "object",
      "title": "Component",
      "description": "One constituent and its amount.",
      "properties": {
        "type": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Component"
          ]
        },
        "constituent": {
          "type": "string",
          "description": "The chemical species or compound this component is made of",
          "examples": [
            "Fe",
            "Si",
            "C"
          ]
        },
        "amount": {
          "type": "object",
          "title": "MassFraction",
          "description": "Mirrors quantities/MassFraction until a cross-module $ref resolves; the quantity, not the unit, says the percentage is by mass",
          "properties": {
            "type": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "MassFraction"
              ]
            },
            "value": {
              "type": "number"
            },
            "unit": {
              "enum": [
                "PERCENT",
                "PPM"
              ],
              "default": "PERCENT",
              "x-enum-varnames": [
                "weight_percent",
                "parts_per_million"
              ]
            },
            "standard_uncertainty": {
              "type": "number",
              "description": "Standard uncertainty, expressed in the unit of value (GUM convention)"
            }
          },
          "required": [
            "type",
            "value",
            "unit"
          ]
        }
      },
      "required": [
        "type",
        "constituent",
        "amount"
      ]
    }
  },
  "@context": {
    "@version": 1.1,
    "emmo": "https://w3id.org/emmo#",
    "obo": "http://purl.obolibrary.org/obo/",
