    "Composition": "https://w3id.org/oo-ld/schemas/materials/0.1/Composition.schema.json",
    "Component": "comp:/$defs/Component",
    "MassFraction": "qkind:MassFraction",
    "percent": "qunit:PERCENT",
    "part_per_million": "qunit:PPM",
    "amount": {
