    {
      "type": [
        "ChemicalComposition"
      ],
      "components": [
        {
          "type": [
            "ChemicalComponent"
          ],
          "constituent": "Fe",
          "amount": {
            "type": [
              "MassFraction"
            ],
            "value": 96.7,
            "unit": "percent"
          }
        }
      ]
    }
  ],
