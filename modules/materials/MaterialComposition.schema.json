{
  "$schema": "https://oo-ld.org/latest/meta/oold-meta-schema.json",
  "$id": "MaterialComposition.schema.json",
  "x-oold-version": "0.1.0",
  "title": "MaterialComposition",
  "description": "The materials a material is made of and how much of each. As specified, typically: a recipe names ingredients, which are materials with a composition of their own, and that is not the same claim as an elemental analysis.",
  "examples": [
    {
      "type": [
        "MaterialComposition"
      ],
      "constituents": [
        {
          "type": [
            "MaterialComponent"
          ],
          "material": "https://example.org/material/batch1",
          "amount": {
            "type": [
              "MassFraction"
            ],
            "value": 96.7,
            "unit": "percent"
          }
        }
      ]
    }
  ],
  "allOf": [
    {
      "$ref": "Composition.schema.json"
    }
  ],
  "@context": [
    "Composition.schema.json",
    {
      "matcomp": {
        "@id": "https://w3id.org/oo-ld/schemas/materials/0.1/MaterialComposition.schema.json#",
        "@prefix": true
      },
      "MaterialComposition": "https://w3id.org/oo-ld/schemas/materials/0.1/MaterialComposition.schema.json",
      "MaterialComponent": "matcomp:/properties/constituents/items",
      "constituents": {
        "@id": "matcomp:/properties/constituents",
        "@type": "@id",
        "@container": "@set"
      },
      "material": {
        "@id": "matcomp:/properties/constituents/items/properties/material",
        "@type": "@id"
      }
    }
  ],
  "properties": {
    "type": {
      "default": [
        "MaterialComposition"
      ]
    },
    "constituents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "Composition.schema.json#/$defs/Component"
          }
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "MaterialComponent"
            ]
          },
          "material": {
            "type": "string",
            "format": "iri-reference",
            "x-oold-range": "Material.schema.json",
            "description": "IRI of the material this component is made of"
          }
        },
        "required": [
          "type",
          "material",
          "amount"
        ]
      }
    }
  },
  "required": [
    "constituents"
  ],
  "x-oold-context": {
    "MaterialComponent": {
      "pmd:PMD_0020102": {
        "x-oold-sssom": {
          "predicate_id": "skos:closeMatch",
          "mapping_set_id": "https://w3id.org/oo-ld/schemas/mappings/pmdco.sssom.tsv",
          "object_source_version": "https://w3id.org/pmd/co/3.1.0",
          "comment": "mass ratio; the constituent is the portion it is a quality of"
        }
      }
    },
    "material": {
      "pmd:PMD_0025999": {
        "@type": "@id",
        "x-oold-sssom": {
          "predicate_id": "skos:closeMatch",
          "mapping_set_id": "https://w3id.org/oo-ld/schemas/mappings/pmdco.sssom.tsv",
          "object_source_version": "https://w3id.org/pmd/co/3.1.0",
          "comment": "relational quality of; a Material is a portion of matter in PMDco"
        }
      }
    }
  }
}
