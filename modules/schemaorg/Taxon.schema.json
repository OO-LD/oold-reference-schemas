  "$schema": "https://oo-ld.org/latest/meta/oold-meta-schema.json",
  "$id": "Taxon.schema.json",
  "x-oold-uuid": "b0768e87-3c3b-5867-af90-d2904f22caad",
  "x-oold-version": "0.1.0",
  "x-oold-iri": "https://schema.org/Taxon",
  "x-oold-instance-rdf-type": [
    "schema:Taxon"
  ],
  "title": "Taxon",
  "description": "A set of organisms asserted to represent a natural cohesive biological unit.",
  "type": "object",
  "properties": {
    "type": {
      "title": "Type",
      "description": "The RDF type(s) of this item.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "schema:Taxon"
      ]
    },
    "childTaxon": {
      "title": "Child Taxon",
      "description": "Closest child taxa of the taxon in question.",
      "type": "array",
      "items": {
        "type": "string",
        "format": "iri-reference",
        "x-oold-range": "Taxon.schema.json"
      }
    },
    "childTaxon_text": {
      "title": "Child Taxon (text)",
      "description": "Closest child taxa of the taxon in question.",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "Text.schema.json"
          },
          {
            "$ref": "URL.schema.json"
          }
        ]
      }
    },
    "hasDefinedTerm": {
      "title": "Has Defined Term",
      "description": "A Defined Term contained in this term set.",
      "type": "array",
      "items": {
        "type": "string",
        "format": "iri-reference",
        "x-oold-range": "DefinedTerm.schema.json"
      }
    },
    "parentTaxon": {
      "title": "Parent Taxon",
      "description": "Closest parent taxon of the taxon in question.",
      "type": "array",
      "items": {
        "type": "string",
        "format": "iri-reference",
        "x-oold-range": "Taxon.schema.json"
      }
    },
    "parentTaxon_text": {
      "title": "Parent Taxon (text)",
      "description": "Closest parent taxon of the taxon in question.",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "Text.schema.json"
          },
          {
            "$ref": "URL.schema.json"
          }
        ]
      }
    },
    "taxonRank": {
      "title": "Taxon Rank",
      "description": "The taxonomic rank of this taxon given preferably as a URI from a controlled vocabulary – typically the ranks from TDWG TaxonRank ontology or equivalent Wikidata URIs.",
      "type": "array",
      "items": {
        "$comment": "NOTE[mixed range]: PropertyValue [value-type]: PropertyValue -> StructuredValue -> Intangible -> Thing",
        "anyOf": [
          {
            "$ref": "Text.schema.json"
          },
          {
            "$ref": "URL.schema.json"
          },
          {
            "$ref": "PropertyValue.schema.json"
          }
        ]
      }
    }
  }
