  "title": "HealthInsurancePlan",
  "description": "A US-style health insurance plan, including PPOs, EPOs, and HMOs.",
  "type": "object",
  "properties": {
    "type": {
      "title": "Type",
      "description": "The RDF type(s) of this item.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "schema:HealthInsurancePlan"
      ]
    },
    "benefitsSummaryUrl": {
      "title": "Benefits Summary Url",
      "description": "The URL that goes directly to the summary of benefits and coverage for the specific standard plan or plan variation.",
      "type": "array",
      "items": {
        "$ref": "URL.schema.json"
      }
    },
    "contactPoint": {
      "title": "Contact Point",
      "description": "A contact point for a person or organization.",
      "type": "array",
      "items": {
        "$ref": "ContactPoint.schema.json"
      }
    },
    "healthPlanDrugOption": {
      "title": "Health Plan Drug Option",
      "description": "TODO.",
      "type": "array",
      "items": {
        "$ref": "Text.schema.json"
      }
    },
    "healthPlanDrugTier": {
      "title": "Health Plan Drug Tier",
      "description": "The tier(s) of drugs offered by this formulary or insurance plan.",
      "type": "array",
      "items": {
        "$ref": "Text.schema.json"
      }
    },
    "healthPlanId": {
      "title": "Health Plan Id",
      "description": "The 14-character, HIOS-generated Plan ID number. (Plan IDs must be unique, even across different markets.)",
      "type": "array",
      "items": {
        "$ref": "Text.schema.json"
      }
    },
    "healthPlanMarketingUrl": {
      "title": "Health Plan Marketing Url",
      "description": "The URL that goes directly to the plan brochure for the specific standard plan or plan variation.",
      "type": "array",
      "items": {
        "$ref": "URL.schema.json"
      }
    },
    "includesHealthPlanFormulary": {
      "title": "Includes Health Plan Formulary",
      "description": "Formularies covered by this plan.",
      "type": "array",
      "items": {
        "type": "string",
        "format": "iri-reference",
        "x-oold-range": "HealthPlanFormulary.schema.json"
      }
    },
    "includesHealthPlanNetwork": {
      "title": "Includes Health Plan Network",
      "description": "Networks covered by this plan.",
      "type": "array",
      "items": {
        "type": "string",
        "format": "iri-reference",
        "x-oold-range": "HealthPlanNetwork.schema.json"
      }
    },
    "usesHealthPlanIdStandard": {
      "title": "Uses Health Plan Id Standard",
      "description": "The standard for interpreting the Plan ID. The preferred is \"HIOS\". See the Centers for Medicare & Medicaid Services for more details.",
