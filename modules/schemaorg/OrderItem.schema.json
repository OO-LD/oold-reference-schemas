      "items": {
        "$ref": "OrderStatus.schema.json#/$defs/member",
        "x-oold-range": "OrderStatus.schema.json"
      }
    },
    "orderQuantity": {
      "title": "Order Quantity",
      "description": "The number of the item ordered. If the property is not set, assume the quantity is one.",
      "type": "array",
      "items": {
        "$comment": "NOTE[mixed range]: QuantitativeValue [value-type]: QuantitativeValue -> StructuredValue -> Intangible -> Thing",
        "anyOf": [
