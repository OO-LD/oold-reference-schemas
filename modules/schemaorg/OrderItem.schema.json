  "title": "OrderItem",
  "description": "An order item is a line of an order. It includes the quantity and shipping details of a bought offer.",
  "type": "object",
  "properties": {
    "type": {
      "title": "Type",
      "description": "The RDF type(s) of this item.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "schema:OrderItem"
      ]
    },
    "orderDelivery": {
      "title": "Order Delivery",
      "description": "The delivery of the parcel related to this order or order item.",
      "type": "array",
      "items": {
        "type": "string",
        "format": "iri-reference",
        "x-oold-range": "ParcelDelivery.schema.json"
      }
    },
    "orderedItem": {
      "title": "Ordered Item",
      "description": "The item ordered.",
      "type": "array",
      "items": {
        "$comment": "NOTE[mixed range]: OrderItem [value-type]: OrderItem -> StructuredValue -> Intangible -> Thing; Product [entity]: Product -> Thing; Service [entity]: Service -> Intangible -> Thing",
        "anyOf": [
          {
            "type": "string",
            "format": "iri-reference",
            "x-oold-range": [
              "Product.schema.json",
              "Service.schema.json"
            ]
          },
          {
            "$ref": "OrderItem.schema.json"
          }
        ]
      }
    },
    "orderItemNumber": {
