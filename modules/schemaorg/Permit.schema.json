  "title": "Permit",
  "description": "A permit issued by an organization, e.g. a parking pass.",
  "type": "object",
  "properties": {
    "type": {
      "title": "Type",
      "description": "The RDF type(s) of this item.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "schema:Permit"
      ]
    },
    "issuedBy": {
      "title": "Issued By",
      "description": "The organization issuing the item, for example a [[Permit]], [[Ticket]], or [[Certification]].",
