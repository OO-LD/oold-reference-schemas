      "items": {
        "anyOf": [
          {
            "$ref": "Date.schema.json"
          },
          {
            "$ref": "DateTime.schema.json"
          }
        ]
      }
    },
    "validIn": {
      "title": "Valid In",
      "description": "The geographic area where the item is valid. Applies for example to a [[Permit]], a [[Certification]], or an [[EducationalOccupationalCredential]]. ",
      "type": "array",
      "items": {
        "type": "string",
        "format": "iri-reference",
        "x-oold-range": "AdministrativeArea.schema.json"
