      "items": {
        "type": "string",
        "format": "iri-reference",
        "x-oold-range": "Organization.schema.json"
      }
    },
    "issuedThrough": {
      "title": "Issued Through",
      "description": "The service through which the permit was granted.",
      "type": "array",
      "items": {
        "type": "string",
        "format": "iri-reference",
        "x-oold-range": "Service.schema.json"
      }
    },
    "permitAudience": {
      "title": "Permit Audience",
      "description": "The target audience for this permit.",
      "type": "array",
      "items": {
        "type": "string",
        "format": "iri-reference",
        "x-oold-range": "Audience.schema.json"
      }
    },
    "validFor": {
