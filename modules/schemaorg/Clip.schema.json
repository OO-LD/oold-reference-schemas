  "title": "Clip",
  "description": "A short TV or radio program or a segment/part of a program.",
  "type": "object",
  "properties": {
    "type": {
      "title": "Type",
      "description": "The RDF type(s) of this item.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "schema:Clip"
      ]
    },
    "actor": {
      "title": "Actor",
      "description": "An actor (individual or a group), e.g. in TV, radio, movie, video games etc., or in an event. Actors can be associated with individual items or with a series, episode, clip.",
      "type": "array",
      "items": {
        "type": "string",
        "format": "iri-reference",
        "x-oold-range": [
          "PerformingGroup.schema.json",
          "Person.schema.json"
        ]
      }
    },
    "clipNumber": {
      "title": "Clip Number",
      "description": "Position of the clip within an ordered group of clips.",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "Integer.schema.json"
          },
          {
            "$ref": "Text.schema.json"
          }
        ]
      }
    },
    "director": {
      "title": "Director",
      "description": "A director of e.g. TV, radio, movie, video gaming etc. content, or of an event. Directors can be associated with individual items or with a series, episode, clip.",
      "type": "array",
      "items": {
        "type": "string",
        "format": "iri-reference",
        "x-oold-range": "Person.schema.json"
      }
    },
    "endOffset": {
      "title": "End Offset",
      "description": "The end time of the clip expressed as the number of seconds from the beginning of the work.",
      "type": "array",
      "items": {
        "type": "string",
        "format": "iri-reference",
        "x-oold-range": "HyperTocEntry.schema.json"
      }
    },
    "endOffset_text": {
      "title": "End Offset (text)",
      "description": "The end time of the clip expressed as the number of seconds from the beginning of the work.",
      "type": "array",
      "items": {
        "$ref": "Number.schema.json"
      }
    },
    "musicBy": {
      "title": "Music By",
      "description": "The composer of the soundtrack.",
      "type": "array",
      "items": {
        "type": "string",
        "format": "iri-reference",
        "x-oold-range": [
          "MusicGroup.schema.json",
          "Person.schema.json"
        ]
      }
    },
    "partOfEpisode": {
