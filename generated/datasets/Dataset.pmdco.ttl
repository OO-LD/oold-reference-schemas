PREFIX csvw: <http://www.w3.org/ns/csvw#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ns1: <https://example.org/cell/>
PREFIX ns2: <https://example.org/data/>
PREFIX ns3: <https://example.org/dataset/>
PREFIX ns4: <https://schemas.oo-ld.org/.well-known/genid/>
PREFIX ns5: <https://w3id.org/oo-ld/schemas/datasets/0.1/CyclingTable.schema.json#/properties/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX qkind: <http://qudt.org/vocab/quantitykind/>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ns3:LFP-042-2026-08-20
    a obo:IAO_0000100 ;
    dcterms:description "Constant current cycling at 1C, 200 cycles" ;
    dcterms:issued "2026-08-20"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Cycling of cell LFP-042" ;
    dcat:distribution ns4:c14n0 ;
.

ns4:c14n0
    a dcat:Distribution ;
    csvw:tableSchema ns4:c14n1 ;
    dcat:accessURL ns2:LFP-042-cycling.csv ;
    dcat:mediaType "text/csv" ;
.

ns4:c14n1
    a csvw:Schema ;
    dcterms:subject ns1:LFP-042 ;
    csvw:column
        ns4:c14n2 ,
        ns4:c14n3 ,
        ns4:c14n4 ;
    ns5:protocol "CC-CV charge at 1C to 3.65 V, rest 10 min, CC discharge at 1C to 2.5 V" ;
.

ns4:c14n2
    a csvw:Column ;
    qudt:hasQuantityKind qkind:Time ;
    qudt:hasUnit obo:UO_0000010 ;
    csvw:name "time" ;
.

ns4:c14n3
    a csvw:Column ;
    qudt:hasQuantityKind qkind:ElectricCurrent ;
    qudt:hasUnit obo:UO_0000037 ;
    csvw:name "current" ;
.

ns4:c14n4
    a csvw:Column ;
    qudt:hasQuantityKind qkind:Voltage ;
    qudt:hasUnit obo:UO_0000218 ;
    csvw:name "voltage" ;
.
