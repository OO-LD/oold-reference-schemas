PREFIX csvw: <http://www.w3.org/ns/csvw#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX emmo: <https://w3id.org/emmo#>
PREFIX ns1: <https://example.org/cell/>
PREFIX ns2: <https://example.org/data/>
PREFIX ns3: <https://example.org/dataset/>
PREFIX ns4: <https://schemas.oo-ld.org/.well-known/genid/>
PREFIX ns5: <https://w3id.org/oo-ld/schemas/datasets/0.1/CyclingTable.schema.json#/properties/>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ns3:LFP-042-2026-08-20
    a emmo:EMMO_194e367c_9783_4bf5_96d0_9ad597d48d9a ;
    dcterms:description "Constant current cycling at 1C, 200 cycles" ;
    dcterms:issued "2026-08-20"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Cycling of cell LFP-042" ;
    dcat:distribution ns4:c14n0 ;
.

ns4:c14n0
    a dcat:Distribution ;
    csvw:tableSchema ns4:c14n1 ;
    dcat:accessURL ns2:LFP-042-cycling.csv ;
    dcat:mediaType "text/csv" ;
.

ns4:c14n1
    a csvw:Schema ;
    dcterms:subject ns1:LFP-042 ;
    csvw:column
        ns4:c14n2 ,
        ns4:c14n3 ,
        ns4:c14n4 ;
    ns5:protocol "CC-CV charge at 1C to 3.65 V, rest 10 min, CC discharge at 1C to 2.5 V" ;
.

ns4:c14n2
    a csvw:Column ;
    qudt:hasQuantityKind emmo:EMMO_c995ae70_3b84_4ebb_bcfc_69e6a281bb88 ;
    qudt:hasUnit emmo:MilliAmpere ;
    csvw:name "current" ;
.

ns4:c14n3
    a csvw:Column ;
    qudt:hasQuantityKind emmo:EMMO_d4f7d378_5e3b_468a_baa1_a7e98358cda7 ;
    qudt:hasUnit emmo:Second ;
    csvw:name "time" ;
.

ns4:c14n4
    a csvw:Column ;
    qudt:hasQuantityKind emmo:EMMO_17b031fb_4695_49b6_bb69_189ec63df3ee ;
    qudt:hasUnit emmo:Volt ;
    csvw:name "voltage" ;
.
