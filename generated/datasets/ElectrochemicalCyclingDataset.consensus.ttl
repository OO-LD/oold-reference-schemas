PREFIX creativecommons_licenses_by_4_0: <https://creativecommons.org/licenses/by/4.0/>
PREFIX dataset_properties: <https://w3id.org/oo-ld/schemas/datasets/0.1/Dataset.schema.json#/properties/>
PREFIX datasets: <https://w3id.org/oo-ld/schemas/datasets/0.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX electrochemicalcyclingdataset__defs: <https://w3id.org/oo-ld/schemas/datasets/0.1/ElectrochemicalCyclingDataset.schema.json#/$defs/>
PREFIX ex_cell: <https://example.org/cell/>
PREFIX ex_dataset: <https://example.org/dataset/>
PREFIX ex_process: <https://example.org/process/>
PREFIX genid: <https://schemas.oo-ld.org/.well-known/genid/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX qunit: <http://qudt.org/vocab/unit/>
PREFIX row: <https://w3id.org/oo-ld/schemas/datasets/0.1/ElectrochemicalCyclingDataset.schema.json#/$defs/ElectrochemicalCyclingDataRow/>
PREFIX row_properties: <https://w3id.org/oo-ld/schemas/datasets/0.1/ElectrochemicalCyclingDataset.schema.json#/$defs/ElectrochemicalCyclingDataRow/properties/>
PREFIX schema1: <http://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ex_dataset:LFP-042-2026-08-20
    a datasets:ElectrochemicalCyclingDataset.schema.json ;
    dcterms:description "Constant current cycling at 1C, first three samples" ;
    dcterms:issued "2026-08-20"^^xsd:date ;
    dcterms:license creativecommons_licenses_by_4_0: ;
    dcterms:title "Cycling of cell LFP-042" ;
    schema1:about ex_cell:LFP-042 ;
    prov:wasGeneratedBy ex_process:LFP-042-cycling ;
    dataset_properties:data
        genid:c14n10 ,
        genid:c14n7 ,
        genid:c14n8 ;
.

genid:c14n0
    a row:TestTime ;
    qudt:hasUnit qunit:SEC ;
    qudt:value 120 ;
.

genid:c14n1
    a row:CellVoltage ;
    qudt:hasUnit qunit:V ;
    qudt:value 3.42e+00 ;
.

genid:c14n10
    a electrochemicalcyclingdataset__defs:ElectrochemicalCyclingDataRow ;
    row_properties:current genid:c14n11 ;
    row_properties:test_time genid:c14n0 ;
    row_properties:voltage genid:c14n3 ;
.

genid:c14n11
    a row:CellCurrent ;
    qudt:hasUnit qunit:MilliA ;
    qudt:value 750 ;
.

genid:c14n2
    a row:TestTime ;
    qudt:hasUnit qunit:SEC ;
    qudt:value 0 ;
.

genid:c14n3
    a row:CellVoltage ;
    qudt:hasUnit qunit:V ;
    qudt:standardUncertainty 2e-03 ;
    qudt:value 3.58e+00 ;
.

genid:c14n4
    a row:CellVoltage ;
    qudt:hasUnit qunit:V ;
    qudt:value 3.51e+00 ;
.

genid:c14n5
    a row:CellCurrent ;
    qudt:hasUnit qunit:MilliA ;
    qudt:value 0 ;
.

genid:c14n6
    a row:TestTime ;
    qudt:hasUnit qunit:SEC ;
    qudt:value 60 ;
.

genid:c14n7
    a electrochemicalcyclingdataset__defs:ElectrochemicalCyclingDataRow ;
    row_properties:current genid:c14n5 ;
    row_properties:test_time genid:c14n2 ;
    row_properties:voltage genid:c14n1 ;
.

genid:c14n8
    a electrochemicalcyclingdataset__defs:ElectrochemicalCyclingDataRow ;
    row_properties:current genid:c14n9 ;
    row_properties:test_time genid:c14n6 ;
    row_properties:voltage genid:c14n4 ;
.

genid:c14n9
    a row:CellCurrent ;
    qudt:hasUnit qunit:MilliA ;
    qudt:value 750 ;
.
