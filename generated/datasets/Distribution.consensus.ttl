PREFIX csvw: <http://www.w3.org/ns/csvw#>
PREFIX datasets: <https://w3id.org/oo-ld/schemas/datasets/0.1/>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ex_data: <https://example.org/data/>
PREFIX ex_distribution: <https://example.org/distribution/>
PREFIX iana_text: <http://www.iana.org/assignments/media-types/text/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ex_distribution:LFP-042-cycling-csv
    a dcat:Distribution ;
    dcterms:conformsTo datasets:ElectrochemicalCyclingDataset.schema.json ;
    csvw:tableSchema datasets:ElectrochemicalCyclingDataRow.schema.json ;
    dcat:byteSize 48213004 ;
    dcat:downloadURL ex_data:LFP-042-cycling.csv ;
    dcat:mediaType iana_text:csv ;
.
